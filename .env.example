# 1. AI & Telegram Baron Secretary Bot
GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_TOKEN=8930942489:AAHXZmZS4GqPzueGx478M3THh8rK5_BWOsI
CEO_USER_ID=7041507751
PARTNER_USER_ID=5471366463

# 2. Infrastructure Collocation & Region (สิงคโปร์ / ไทย ลด Latency ข้ามประเทศ)
CLOUD_REGION=asia-southeast1
PORT=3000

# 3. Redis Spatial Cache (Geo-hash ~150m grid, Cached responses <10ms)
ENABLE_REDIS=true
REDIS_URL=redis://127.0.0.1:6379
# หรือแยก Host/Port:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# 4. Collocated Regional OSRM Server (Internal local network <1ms หรือ Regional Mirror)
# หากใช้ Docker Collocation ให้ชี้ไปที่ http://osrm:5000
OSRM_BASE_URL=https://router.project-osrm.org

# 5. Regional CartoDB / Tile CDN
CARTO_TILE_CDN=https://a.basemaps.cartocdn.com

# 6. HTTP Keep-Alive Connection Pool
HTTP_KEEP_ALIVE_TIMEOUT=30000
HTTP_MAX_SOCKETS=120
